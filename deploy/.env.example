# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# The public host name; the relay's URL is https://<this>. DNS A/AAAA records must point here.
KLATSCH_DOMAIN=klatsch.example.org
# Image to run; pin a release tag (or digest) in production.
KLATSCH_IMAGE=ghcr.io/gizemsoylutr/klatsch:latest

# Optional email (notifications and sign-in links): both or neither. TLS is enforced for non-local SMTP servers.
# Brevo: smtp://<login, @ as %40>:<SMTP key>@smtp-relay.brevo.com:587. For a Docker secret, see docs/self-hosting.md.
KLATSCH_SMTP_URL=
KLATSCH_MAIL_FROM=

# Optional "Sign in with GitHub": a GitHub OAuth App with the callback URL https://<KLATSCH_DOMAIN>/ui/auth/github/callback.
# Both or neither. For a Docker secret instead of the secret here, see docs/self-hosting.md.
KLATSCH_GITHUB_CLIENT_ID=
KLATSCH_GITHUB_CLIENT_SECRET=

# Optional "Sign in with Google": an OAuth client (Web application) with the redirect URI https://<KLATSCH_DOMAIN>/ui/auth/google/callback.
KLATSCH_GOOGLE_CLIENT_ID=
KLATSCH_GOOGLE_CLIENT_SECRET=

# Who runs this relay, for its /privacy and /terms pages. All or none; read docs/self-hosting.md first.
KLATSCH_OPERATOR_NAME=
KLATSCH_OPERATOR_EMAIL=
KLATSCH_OPERATOR_PROCESSORS=

# Optional guest mode: 1 adds "Try it without an account" (5 hours, only the demo friend). Off when empty.
KLATSCH_GUEST=

# Litestream: S3-compatible bucket at another provider than the server, ideally in the EU.
LITESTREAM_ENDPOINT=https://s3.example-provider.eu
LITESTREAM_REGION=eu-central-1
LITESTREAM_BUCKET=klatsch-backup
LITESTREAM_PATH=klatsch
# A key limited to this one bucket.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
