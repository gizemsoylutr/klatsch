{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^@?[a-z0-9][a-z0-9-]{0,38}$",
      "description": "The friend's handle, e.g. \"@ayse\"."
    }
  },
  "required": [
    "handle"
  ],
  "additionalProperties": false
}
