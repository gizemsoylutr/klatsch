{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tags": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "A tag from the Klatsch vocabulary, e.g. \"postgres\", \"react\", \"oauth\""
      },
      "description": "Tags of the problem you are looking for help with"
    }
  },
  "required": [
    "tags"
  ],
  "additionalProperties": false
}
