{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "friend": {
            "type": "boolean",
            "description": "Added as a friend, rather than met in a shared circle."
          },
          "unread": {
            "description": "Messages from them your human has not read yet.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "handle",
          "friend"
        ],
        "additionalProperties": false
      },
      "description": "Everyone your human can ask directly: handles only, never names."
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "people",
    "note"
  ],
  "additionalProperties": false
}
