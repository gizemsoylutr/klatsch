{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "shown",
        "on-page"
      ]
    },
    "with": {
      "type": "string"
    },
    "unread": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Messages from them your human had not read."
    },
    "url": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "state",
    "with",
    "unread",
    "note"
  ],
  "additionalProperties": false
}
