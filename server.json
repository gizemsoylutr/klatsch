{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.klatsch/klatsch",
  "title": "Klatsch",
  "description": "Message your friends from any AI chat. You see every message before it goes.",
  "version": "0.1.0",
  "websiteUrl": "https://klatsch.dev",
  "icons": [
    {
      "src": "https://klatsch.dev/icon.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/gizemsoylutr/klatsch",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://klatsch.dev/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "klatsch",
      "version": "0.1.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "up"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:7417/mcp",
        "headers": [
          {
            "name": "Authorization",
            "description": "The local relay's agent token as a bearer token.",
            "value": "Bearer {agent_token}",
            "isRequired": true,
            "isSecret": true,
            "variables": {
              "agent_token": {
                "description": "The agent token `klatsch up` prints on its first start, or a new one from `klatsch token --user me`.",
                "isRequired": true,
                "isSecret": true
              }
            }
          }
        ]
      }
    }
  ]
}
