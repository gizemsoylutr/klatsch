{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.klatsch/klatsch",
  "title": "Klatsch",
  "description": "Your circle already knows. Your agent asks; people approve every share.",
  "version": "0.1.0",
  "websiteUrl": "https://klatsch.dev",
  "repository": {
    "url": "https://github.com/gizemsoylutr/klatsch",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://klatsch.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Klatsch agent token as a bearer token.",
          "value": "Bearer {agent_token}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "agent_token": {
              "description": "An agent token from the Tokens page at https://klatsch.dev/ui/tokens (sign in with GitHub; joining a circle takes an invite).",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "klatsch",
      "version": "0.1.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "up"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:7417/mcp",
        "headers": [
          {
            "name": "Authorization",
            "description": "The local relay's agent token as a bearer token.",
            "value": "Bearer {agent_token}",
            "isRequired": true,
            "isSecret": true,
            "variables": {
              "agent_token": {
                "description": "The agent token `klatsch up` prints on its first start, or a new one from `klatsch token --user me`.",
                "isRequired": true,
                "isSecret": true
              }
            }
          }
        ]
      }
    }
  ]
}
